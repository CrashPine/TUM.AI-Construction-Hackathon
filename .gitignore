# Local secrets such as API keys. Commit a .env.example without values instead.
.env
.env.*
!.env.example

# Python and tools: virtual environment, bytecode and caches.
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/

# Default local review database, including any SQLite sidecar files.
bidguard-history.sqlite3*
frontend/node_modules/
